        <Button Grid.Column="5" x:Name="ApplyCurveSlot" Content="载入并应用" Padding="10,7" Margin="0"/>
       </Grid>
       <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="拖动节点调整 · 点击空白添加 · 右键节点删除" Style="{StaticResource Label}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="UndoCurve" Content="↶ 撤销" Padding="10,6" ToolTip="Ctrl+Z"/><Button x:Name="RedoCurve" Content="↷ 重做" Padding="10,6" ToolTip="Ctrl+Y" Margin="0"/></StackPanel></Grid>
       <Border Background="{DynamicResource Bg}" CornerRadius="7" Margin="0,10,0,12"><Grid x:Name="CurveChartHost" Height="192" Margin="8,4,8,2"/></Border>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="SelectedNodeLabel" Text="节点 1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="SelectedTemperature" Width="58" MaxLength="3" ToolTip="节点温度，输入后按 Enter"/><TextBlock Text="°C" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="6,0,12,0"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBox x:Name="SelectedLevel" Width="45" MaxLength="1" ToolTip="风扇档位 0–7，输入后按 Enter"/><TextBlock Text="档" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="6,0,12,0"/></StackPanel>
        <Button Grid.Column="3" x:Name="UpdateCurvePoint" Content="更新节点" Padding="12,7"/>
        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="AddCurvePoint" Content="＋ 节点" Padding="10,7"/><Button x:Name="DeleteCurvePoint" Content="删除" Padding="10,7" Margin="0"/></StackPanel>
       </Grid>
       <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="SaveCurve" Content="保存并应用" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" Padding="16,9"/><Button x:Name="ResetCurve" Content="载入均衡" Padding="12,9"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="方向键微调 · Shift 加速 · Delete 删除" Style="{StaticResource Label}" FontSize="10"/><TextBlock Text="降温回差 3°C · 延迟 8 秒" Style="{StaticResource Label}" FontSize="10" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel></Grid>
       <TextBlock x:Name="CurveMessage" Text="选中节点，输入数值后按 Enter。" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Padding="18,12"><Expander x:Name="ManualExpander" Header="手动调速" Foreground="{DynamicResource Text}" IsExpanded="False"><StackPanel Margin="0,12,0,4"><DockPanel><TextBlock Text="固定风扇档位" Style="{StaticResource Label}"/><TextBlock x:Name="ManualLabel" Text="4 档" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/></DockPanel><Slider x:Name="ManualSlider" Minimum="0" Maximum="7" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Margin="0,15,0,4"/><DockPanel><TextBlock Text="0 · 停转" Style="{StaticResource Label}"/><TextBlock Text="7 · 最高档" Style="{StaticResource Label}" HorizontalAlignment="Right"/></DockPanel><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="ApplyManual" Content="应用手动档位"/><Button x:Name="IncreaseFan" Content="＋ 增加一档"/><Button x:Name="BoostFan" Content="最高档"/><Button x:Name="RestoreBios" Content="恢复自动"/></StackPanel></StackPanel></Expander></Border>
     </StackPanel>
     <StackPanel x:Name="BatteryPage" Visibility="Collapsed">
      <Border Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="BatteryName" Text="电池" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="容量、健康与当前充放电状态" Style="{StaticResource Label}" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" x:Name="BatteryState" Text="等待电池数据" Foreground="{DynamicResource Green}" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></Border>
      <UniformGrid Columns="3" Margin="-5,0,-5,12">
       <Border Style="{StaticResource CardStyle}" Margin="5"><StackPanel><TextBlock Text="当前电量" Style="{StaticResource Label}"/><TextBlock x:Name="BatteryCharge" Text="— %" Style="{StaticResource Metric}"/><TextBlock Text="电池剩余电量" Style="{StaticResource Label}"/></StackPanel></Border>
       <Border Style="{StaticResource CardStyle}" Margin="5"><StackPanel><TextBlock Text="电池健康度" Style="{StaticResource Label}"/><TextBlock x:Name="BatteryHealth" Text="— %" Style="{StaticResource Metric}" Foreground="{DynamicResource Green}"/><TextBlock Text="满充容量 / 设计容量" Style="{StaticResource Label}"/></StackPanel></Border>
       <Border Style="{StaticResource CardStyle}" Margin="5"><StackPanel><TextBlock Text="充放电功率" Style="{StaticResource Label}"/><TextBlock x:Name="BatteryPower" Text="— W" Style="{StaticResource Metric}" FontSize="28" Foreground="{DynamicResource Accent}"/><TextBlock Text="电池端净充放电功率" Style="{StaticResource Label}"/></StackPanel></Border>
      </UniformGrid>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="电池容量" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15"/>
        <Grid Margin="0,0,0,13"><TextBlock Text="设计容量" Style="{StaticResource Label}"/><TextBlock x:Name="BatteryDesign" Text="— Wh" HorizontalAlignment="Right"/></Grid>
        <Grid Margin="0,0,0,13"><TextBlock Text="当前满充" Style="{StaticResource Label}"/><TextBlock x:Name="BatteryFull" Text="— Wh" HorizontalAlignment="Right"/></Grid>
        <Grid><TextBlock Text="剩余容量" Style="{StaticResource Label}"/><TextBlock x:Name="BatteryRemaining" Text="— Wh" HorizontalAlignment="Right"/></Grid>
       </StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,0,0"><StackPanel><TextBlock Text="运行状态" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15"/>
        <Grid Margin="0,0,0,13"><TextBlock Text="循环次数" Style="{StaticResource Label}"/><TextBlock x:Name="BatteryCycles" Text="— 次" HorizontalAlignment="Right"/></Grid>
        <Grid Margin="0,0,0,13"><TextBlock Text="电压" Style="{StaticResource Label}"/><TextBlock x:Name="BatteryVoltage" Text="— V" HorizontalAlignment="Right"/></Grid>
        <Grid Margin="0,0,0,13"><TextBlock Text="温度" Style="{StaticResource Label}"/><TextBlock x:Name="BatteryTemperature" Text="— °C" HorizontalAlignment="Right"/></Grid>
        <Grid><TextBlock Text="预计续航" Style="{StaticResource Label}"/><TextBlock x:Name="BatteryRuntime" Text="—" HorizontalAlignment="Right"/></Grid>
       </StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource CardStyle}"><StackPanel><DockPanel><TextBlock Text="充放电趋势" FontWeight="SemiBold"/><TextBlock Text="最近 60 秒 · W" Style="{StaticResource Label}" HorizontalAlignment="Right"/></DockPanel><Canvas x:Name="BatteryPowerChart" Height="110" ClipToBounds="True" Margin="0,12,0,0"/><TextBlock x:Name="BatteryStatus" Text="正在读取电池信息…" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="StoragePage" Visibility="Collapsed">
      <Border Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,0,0,16"><StackPanel><TextBlock Text="存储健康" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="温度、寿命与累计读写" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
      <StackPanel x:Name="StorageCards"/>
      <TextBlock x:Name="StorageStatus" Text="正在读取 SSD 信息…" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0"/>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="外观" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="浅色、深色与跟随系统" Style="{StaticResource Label}" Margin="0,7,0,18"/><StackPanel Orientation="Horizontal"><Button x:Name="ThemeSystem" Content="跟随系统"/><Button x:Name="ThemeLight" Content="浅色  Light"/><Button x:Name="ThemeDark" Content="深色  Dark"/></StackPanel></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="启动与托盘" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/><CheckBox x:Name="StartupCheck" Content="开机登录后启动，驻留托盘"/><CheckBox x:Name="TrayCheck" Content="关闭窗口时最小化到托盘"/><CheckBox x:Name="MinimizedCheck" Content="打开应用时直接进入托盘"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="启动风扇策略" VerticalAlignment="Center" Margin="0,0,18,0"/><ComboBox Grid.Column="1" x:Name="StartupPolicyPicker" MaxWidth="360" HorizontalAlignment="Left" MinWidth="260" ToolTip="连接后自动应用的风扇策略"/></Grid><TextBlock Text="连接后自动应用所选策略。" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="双击托盘打开窗口，右键切换策略或退出。" Style="{StaticResource Label}" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="硬件连接" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="MachineLabel" Text="正在识别设备" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,12,0,6"/><TextBlock x:Name="HardwareStatus" Text="正在连接" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,16"/><WrapPanel><Button x:Name="InstallHardware" Content="配置硬件组件" Margin="0,0,8,8"/><Button x:Name="Elevate" Content="管理员模式" Margin="0,0,8,8"/><Button x:Name="Reconnect" Content="重新连接" Margin="0,0,8,8"/><Button x:Name="ExportReport" Content="导出检测报告" Margin="0,0,8,8"/></WrapPanel><TextBlock x:Name="SettingsMessage" Text="" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <Border x:Name="ActionFeedbackBar" Grid.Row="2" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,12,0,0" Visibility="Collapsed"><TextBlock x:Name="ActionFeedbackText" Text="" TextWrapping="Wrap" Foreground="{DynamicResource Text}"/></Border>
   <DockPanel Grid.Row="3" Margin="0,18,0,0"><TextBlock x:Name="ConnectionLabel" Text="正在连接设备…" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="620"/><TextBlock x:Name="TimeLabel" Text="" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource Muted}"/></DockPanel>
  </Grid>
  </Grid>
 </Grid>
</Window>
