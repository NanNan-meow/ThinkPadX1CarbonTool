<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Carbon Control" Width="1080" Height="790" MinWidth="960" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Bg" Color="#101214"/><SolidColorBrush x:Key="Sidebar" Color="#151719"/>
  <SolidColorBrush x:Key="Card" Color="#1B1E21"/><SolidColorBrush x:Key="Input" Color="#25292D"/>
  <SolidColorBrush x:Key="Line" Color="#303439"/><SolidColorBrush x:Key="Text" Color="#F1F3F4"/>
  <SolidColorBrush x:Key="Muted" Color="#9AA2AB"/><SolidColorBrush x:Key="Accent" Color="#F16470"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#382128"/><SolidColorBrush x:Key="Green" Color="#70CCA7"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Input}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="16,10"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="20,13"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
  <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,9,0,3"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Margin" Value="0,10,0,10"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="CaretBrush" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="10,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="ScrollPage" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid x:Name="ScrollRoot" Background="{TemplateBinding Background}">
    <Border x:Name="ScrollRail" Background="{DynamicResource Line}" Width="2" HorizontalAlignment="Center" CornerRadius="1" Margin="0,3" Opacity="0.45"/>
    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.DecreaseRepeatButton><RepeatButton x:Name="ScrollDecrease" Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb x:Name="ScrollThumb" Background="{DynamicResource Muted}" MinHeight="28" Opacity="0.5"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ScrollGrip" Background="{TemplateBinding Background}" CornerRadius="3" Margin="3,1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollGrip" Property="Background" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ScrollGrip" Property="Background" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton x:Name="ScrollIncrease" Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton>
    </Track>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollThumb" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="ScrollRail" Property="Width" Value="Auto"/><Setter TargetName="ScrollRail" Property="Height" Value="2"/><Setter TargetName="ScrollRail" Property="HorizontalAlignment" Value="Stretch"/><Setter TargetName="ScrollRail" Property="VerticalAlignment" Value="Center"/><Setter TargetName="ScrollThumb" Property="MinHeight" Value="0"/><Setter TargetName="ScrollThumb" Property="MinWidth" Value="28"/><Setter TargetName="ScrollDecrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="ScrollIncrease" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="10,7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboBorder" Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,5,26,5" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,3,0,0" Padding="4"><ScrollViewer MaxHeight="220" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="8,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="SlotItem" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="SlotItem" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="182"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <Grid Margin="16,30,16,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal" Margin="8,0,0,0"><TextBlock Text="carbon" FontSize="27" FontWeight="Bold"/><Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="4,17,0,0"/></StackPanel><TextBlock Text="THERMAL CONTROL" Foreground="{DynamicResource Muted}" FontSize="9" Margin="9,4,0,34"/></StackPanel>
    <StackPanel Grid.Row="1"><Button x:Name="NavMonitor" Content="◉   监控总览" Style="{StaticResource Nav}"/><Button x:Name="NavFan" Content="≋   风扇策略" Style="{StaticResource Nav}"/><Button x:Name="NavSettings" Content="⚙   设置" Style="{StaticResource Nav}"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="8,0,0,0"><Border Background="{DynamicResource AccentSoft}" CornerRadius="4" HorizontalAlignment="Left" Padding="7,3"><TextBlock Text="X1 CARBON" FontSize="10" Foreground="{DynamicResource Accent}" FontWeight="Bold"/></Border><TextBlock x:Name="ModelCaption" Text="Gen 8 · i5-10210U" Style="{StaticResource Label}" Margin="0,10,0,4"/><TextBlock Text="Carbon Control 1.3.0" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="30,28,30,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><StackPanel><TextBlock x:Name="PageTitle" Text="监控总览" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="掌握温度，让性能从容发挥。" Style="{StaticResource Label}" Margin="0,7,0,0"/></StackPanel><TextBlock x:Name="LiveLabel" Text="●  实时 · 1 秒刷新" Foreground="{DynamicResource Green}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/></Grid>
   <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="MonitorPage">
      <UniformGrid Columns="3" Rows="2" Margin="-5,0,-5,16">
       <Border Style="{StaticResource CardStyle}" Margin="5"><StackPanel><TextBlock Text="CPU 温度" Style="{StaticResource Label}"/><TextBlock x:Name="CpuTemp" Text="— °C" Style="{StaticResource Metric}" Foreground="{DynamicResource Accent}"/><TextBlock Text="处理器封装" Style="{StaticResource Label}"/></StackPanel></Border>
       <Border Style="{StaticResource CardStyle}" Margin="5"><StackPanel><TextBlock Text="CPU 频率" Style="{StaticResource Label}"/><TextBlock x:Name="CpuClock" Text="— GHz" Style="{StaticResource Metric}"/><TextBlock Text="核心平均频率" Style="{StaticResource Label}"/></StackPanel></Border>
       <Border Style="{StaticResource CardStyle}" Margin="5"><StackPanel><TextBlock Text="CPU 功耗" Style="{StaticResource Label}"/><TextBlock x:Name="CpuPower" Text="— W" Style="{StaticResource Metric}"/><TextBlock Text="整包功耗 · 含核显" Style="{StaticResource Label}"/></StackPanel></Border>
       <Border Style="{StaticResource CardStyle}" Margin="5"><StackPanel><TextBlock Text="CPU 使用率" Style="{StaticResource Label}"/><TextBlock x:Name="CpuLoad" Text="— %" Style="{StaticResource Metric}"/><TextBlock Text="全部逻辑处理器" Style="{StaticResource Label}"/></StackPanel></Border>
       <Border Style="{StaticResource CardStyle}" Margin="5"><StackPanel><TextBlock Text="GPU 使用率" Style="{StaticResource Label}"/><TextBlock x:Name="GpuLoad" Text="— %" Style="{StaticResource Metric}"/><TextBlock Text="Intel UHD · 最忙引擎" Style="{StaticResource Label}"/></StackPanel></Border>
       <Border Style="{StaticResource CardStyle}" Margin="5"><StackPanel><TextBlock Text="GPU 功耗" Style="{StaticResource Label}"/><TextBlock x:Name="GpuPower" Text="— W" Style="{StaticResource Metric}"/><TextBlock Text="Intel 核显功耗" Style="{StaticResource Label}"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><DockPanel><TextBlock Text="温度趋势" FontWeight="SemiBold"/><TextBlock Text="最近 60 秒  ·  °C" Style="{StaticResource Label}" HorizontalAlignment="Right"/></DockPanel><Canvas x:Name="HistoryChart" Height="146" ClipToBounds="True" Margin="0,14,0,4"/><DockPanel><TextBlock Text="60 秒前" Style="{StaticResource Label}"/><TextBlock Text="现在" Style="{StaticResource Label}" HorizontalAlignment="Right"/></DockPanel></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="FanSummary" Text="风扇  — RPM" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="FanSummaryMode" Text="系统自动" Style="{StaticResource Label}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="OverviewFullSpeed" Content="全速 · 7 档" ToolTip="固定 7 档，再点返回原策略"/><Button x:Name="GoFan" Content="调整风扇  →"/></StackPanel></Grid></Border>
     </StackPanel>
     <StackPanel x:Name="FanPage" Visibility="Collapsed">
      <Border Style="{StaticResource CardStyle}" Padding="18,12" Margin="0,0,0,12"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="运行策略" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="FanControlStatus" Text="正在连接" Style="{StaticResource Label}" FontSize="11" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" Margin="10,0,14,0"/><TextBlock Grid.Column="2" x:Name="FanActual" Text="— RPM" VerticalAlignment="Center" Foreground="{DynamicResource Green}" Margin="0,0,14,0"/><Button Grid.Column="3" x:Name="QuickFullSpeed" Content="全速 · 7 档" ToolTip="固定 7 档，再点返回原策略" Padding="12,6" Margin="0"/></Grid><UniformGrid Columns="5" Margin="0,10,-8,0"><Button x:Name="ModeBios" Content="系统自动"/><Button x:Name="ModeQuiet" Content="安静"/><Button x:Name="ModeBalanced" Content="均衡"/><Button x:Name="ModeCool" Content="强冷"/><Button x:Name="ModeCustom" Content="自定义"/></UniformGrid><TextBlock x:Name="PolicyDescription" Text="由 ThinkPad 固件自动调节风扇。" Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
      <Border x:Name="CurveCard" Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,0,12"><StackPanel>
       <DockPanel><TextBlock Text="绘制风扇曲线" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="CurveDraftLabel" Text="6 个节点" Foreground="{DynamicResource Accent}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
       <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="存档" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <ComboBox Grid.Column="1" x:Name="CurveSlotPicker" MinWidth="136" Foreground="{DynamicResource Text}" Background="{DynamicResource Input}" BorderBrush="{DynamicResource Line}" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="选择曲线存档槽位"/>
        <TextBox Grid.Column="2" x:Name="CurveSlotName" MinWidth="90" MaxLength="24" FontSize="12" Margin="0,0,8,0" ToolTip="存档名称，点击存入保存"/>
        <Button Grid.Column="3" x:Name="SaveCurveSlot" Content="存入" Padding="10,7" ToolTip="保存到当前槽位，覆盖此槽位原有曲线"/>
        <Button Grid.Column="4" x:Name="LoadCurveSlot" Content="载入" Padding="10,7"/>
        <Button Grid.Column="5" x:Name="ApplyCurveSlot" Content="载入并应用" Padding="10,7" Margin="0"/>
       </Grid>
       <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="拖动节点调整 · 点击空白添加 · 右键节点删除" Style="{StaticResource Label}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="UndoCurve" Content="↶ 撤销" Padding="10,6" ToolTip="Ctrl+Z"/><Button x:Name="RedoCurve" Content="↷ 重做" Padding="10,6" ToolTip="Ctrl+Y" Margin="0"/></StackPanel></Grid>
       <Border Background="{DynamicResource Bg}" CornerRadius="7" Margin="0,10,0,12"><Grid x:Name="CurveChartHost" Height="192" Margin="8,4,8,2"/></Border>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="SelectedNodeLabel" Text="节点 1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="SelectedTemperature" Width="58" MaxLength="3" ToolTip="节点温度，输入后按 Enter"/><TextBlock Text="°C" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="6,0,12,0"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBox x:Name="SelectedLevel" Width="45" MaxLength="1" ToolTip="风扇档位 0–7，输入后按 Enter"/><TextBlock Text="档" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="6,0,12,0"/></StackPanel>
        <Button Grid.Column="3" x:Name="UpdateCurvePoint" Content="更新节点" Padding="12,7"/>
        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="AddCurvePoint" Content="＋ 节点" Padding="10,7"/><Button x:Name="DeleteCurvePoint" Content="删除" Padding="10,7" Margin="0"/></StackPanel>
       </Grid>
       <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="SaveCurve" Content="保存并应用" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" Padding="16,9"/><Button x:Name="ResetCurve" Content="载入均衡" Padding="12,9"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="方向键微调 · Shift 加速 · Delete 删除" Style="{StaticResource Label}" FontSize="10"/><TextBlock Text="降温回差 3°C · 延迟 8 秒" Style="{StaticResource Label}" FontSize="10" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel></Grid>
       <TextBlock x:Name="CurveMessage" Text="选中节点后，也可以输入数值精确调整。" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Padding="18,12"><Expander x:Name="ManualExpander" Header="手动调速" Foreground="{DynamicResource Text}" IsExpanded="False"><StackPanel Margin="0,12,0,4"><DockPanel><TextBlock Text="固定风扇档位" Style="{StaticResource Label}"/><TextBlock x:Name="ManualLabel" Text="4 档" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/></DockPanel><Slider x:Name="ManualSlider" Minimum="0" Maximum="7" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Margin="0,15,0,4"/><DockPanel><TextBlock Text="0 · 停转" Style="{StaticResource Label}"/><TextBlock Text="7 · 最高档" Style="{StaticResource Label}" HorizontalAlignment="Right"/></DockPanel><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="ApplyManual" Content="应用手动档位"/><Button x:Name="IncreaseFan" Content="＋ 增加一档"/><Button x:Name="BoostFan" Content="最高档"/><Button x:Name="RestoreBios" Content="恢复自动"/></StackPanel></StackPanel></Expander></Border>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="外观" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="选择熟悉的明暗风格。" Style="{StaticResource Label}" Margin="0,7,0,18"/><StackPanel Orientation="Horizontal"><Button x:Name="ThemeSystem" Content="跟随系统"/><Button x:Name="ThemeLight" Content="浅色  Light"/><Button x:Name="ThemeDark" Content="深色  Dark"/></StackPanel></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="启动与托盘" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/><CheckBox x:Name="StartupCheck" Content="开机登录后启动，驻留托盘"/><CheckBox x:Name="TrayCheck" Content="关闭窗口时最小化到托盘"/><CheckBox x:Name="MinimizedCheck" Content="打开应用时直接进入托盘"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="启动风扇策略" VerticalAlignment="Center" Margin="0,0,18,0"/><ComboBox Grid.Column="1" x:Name="StartupPolicyPicker" MaxWidth="360" HorizontalAlignment="Left" MinWidth="260" ToolTip="打开应用并连接成功后自动启用的风扇策略"/></Grid><TextBlock Text="打开应用后，等待温度和风扇连接正常，再自动启用所选策略。" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="托盘双击打开窗口，右键可切换策略或退出。" Style="{StaticResource Label}" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="硬件连接" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="MachineLabel" Text="正在识别设备" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,12,0,6"/><TextBlock x:Name="HardwareStatus" Text="正在连接" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,16"/><WrapPanel><Button x:Name="InstallHardware" Content="配置硬件组件" Margin="0,0,8,8"/><Button x:Name="Elevate" Content="管理员模式" Margin="0,0,8,8"/><Button x:Name="Reconnect" Content="重新连接" Margin="0,0,8,8"/><Button x:Name="ExportReport" Content="导出检测报告" Margin="0,0,8,8"/></WrapPanel><TextBlock x:Name="SettingsMessage" Text="" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <DockPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="ConnectionLabel" Text="正在连接设备…" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="620"/><TextBlock x:Name="TimeLabel" Text="" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource Muted}"/></DockPanel>
  </Grid>
 </Grid>
</Window>
